{
  "name": "ipvio-stream-webos",
  "version": "0.0.1",
  "private": true,
  "description": "IPVIO Stream for LG webOS TVs, a port of the IPVIO Stream Android TV IPTV player.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "npm run package && node scripts/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
